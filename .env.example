# BaliBuddy Environment Variables
# Copy this file to .env.local and fill in your values

# ===== AI (Anthropic Claude) =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# ===== WhatsApp Business API =====
# Option A: Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Option B: 360dialog (cheaper for Indonesia)
DIALOG_API_KEY=xxxxxxxxxx
WHATSAPP_BUSINESS_NUMBER=628xxxxxxxxxx

# ===== Database (Supabase) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# ===== Payments (Xendit - Indonesia) =====
XENDIT_SECRET_KEY=xnd_production_xxxxx
XENDIT_PUBLIC_KEY=xnd_public_production_xxxxx
XENDIT_WEBHOOK_TOKEN=xxxxx

# ===== Analytics =====
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ===== App Config =====
NEXT_PUBLIC_APP_URL=https://balibuddy.com
NEXT_PUBLIC_WHATSAPP_NUMBER=628xxxxxxxxxx